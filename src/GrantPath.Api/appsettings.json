{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "grantpath": "Host=localhost;Port=5432;Database=grantpath;Username=grantpath;Password=grantpath"
  },
  "GrantPath": {
    "Rebac": {
      "ApiUrl": "http://localhost:8080",
      "StoreName": "grantpath"
    },
    "Decision": {
      "ResolveRelationshipPath": true,
      "ContainmentCacheLifetime": "00:05:00",
      "PolicyCacheLifetime": "00:00:30"
    },
    "Audit": {
      "QueueCapacity": 8192,
      "BatchSize": 200,
      "FlushInterval": "00:00:00.250"
    },
    "Projection": {
      "Enabled": true,
      "PollInterval": "00:00:00.500",
      "Relation": "viewer"
    },
    "Callers": {
      "AllowAnonymous": false,
      "ApiKeys": []
    },
    "Database": {
      "MigrateOnStartup": false,
      "SeedDemoData": false
    }
  }
}
